# Configurações do OpenRouter / OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Alternativa configuravel ao OpenAI (RF14 pede OpenAI; Gemini foi adicionado
# como opcao). LLM_PROVIDER=openai|gemini decide qual usar; sem nenhuma chave,
# o sistema cai automaticamente no modo local (sem chamada a modelo).
LLM_PROVIDER=openai
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

APP_ENV=development